{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "type": {
                "type": "string",
                "title": "Entity Type"
            },
            "url": {
                "type": "string",
                "title": "Substack URL"
            },
            "id": {
                "type": "string",
                "title": "Post / Publication ID"
            },
            "postId": {
                "type": "string",
                "title": "Parent Post ID"
            },
            "title": {
                "type": "string",
                "title": "Article Title / Publication Name"
            },
            "subtitle": {
                "type": "string",
                "title": "Article Subtitle"
            },
            "slug": {
                "type": "string",
                "title": "Article Slug"
            },
            "bodyText": {
                "type": "string",
                "title": "Full Article Plain Text (AI / LLM Ready)"
            },
            "bodyHtml": {
                "type": "string",
                "title": "Full Article HTML"
            },
            "description": {
                "type": "string",
                "title": "Description / Excerpt"
            },
            "publicationName": {
                "type": "string",
                "title": "Publication Name"
            },
            "publicationSubdomain": {
                "type": "string",
                "title": "Publication Subdomain"
            },
            "publicationUrl": {
                "type": "string",
                "title": "Publication URL"
            },
            "publicationLogoUrl": {
                "type": "string",
                "title": "Publication Logo URL"
            },
            "subscriberHint": {
                "type": "string",
                "title": "Subscriber / Ranking Tier"
            },
            "primaryAuthor": {
                "type": "string",
                "title": "Author Name"
            },
            "authors": {
                "type": "array",
                "title": "Authors List",
                "items": {
                    "type": "object"
                }
            },
            "coverImageUrl": {
                "type": "string",
                "title": "Cover Image URL"
            },
            "likesCount": {
                "type": "integer",
                "title": "Likes / Reactions Count"
            },
            "commentsCount": {
                "type": "integer",
                "title": "Comments Count"
            },
            "restacksCount": {
                "type": "integer",
                "title": "Restacks Count"
            },
            "isPaid": {
                "type": "boolean",
                "title": "Is Paid / Paywalled"
            },
            "audience": {
                "type": "string",
                "title": "Target Audience (everyone, only_paid)"
            },
            "wordCount": {
                "type": "integer",
                "title": "Article Word Count"
            },
            "readingTimeMinutes": {
                "type": "integer",
                "title": "Reading Time (Minutes)"
            },
            "commentText": {
                "type": "string",
                "title": "Comment Text"
            },
            "commentAuthor": {
                "type": "string",
                "title": "Comment Author"
            },
            "commentHandle": {
                "type": "string",
                "title": "Comment Author Handle"
            },
            "commentLikes": {
                "type": "integer",
                "title": "Comment Likes"
            },
            "email": {
                "type": "string",
                "title": "Contact Email"
            },
            "emails": {
                "type": "array",
                "title": "Extracted Emails",
                "items": {
                    "type": "string"
                }
            },
            "phones": {
                "type": "array",
                "title": "Extracted Phones",
                "items": {
                    "type": "string"
                }
            },
            "socialLinks": {
                "type": "array",
                "title": "Social Links",
                "items": {
                    "type": "string"
                }
            },
            "searchQuery": {
                "type": "string",
                "title": "Search Keyword"
            },
            "source": {
                "type": "string",
                "title": "Extraction Source Engine"
            },
            "publishedAt": {
                "type": "string",
                "title": "Published Timestamp"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped At Timestamp"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "title",
                    "publicationName",
                    "primaryAuthor",
                    "likesCount",
                    "commentsCount",
                    "wordCount",
                    "audience",
                    "url",
                    "publishedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": { "label": "Type", "format": "text" },
                    "title": { "label": "Title", "format": "text" },
                    "publicationName": { "label": "Publication", "format": "text" },
                    "primaryAuthor": { "label": "Author", "format": "text" },
                    "likesCount": { "label": "Likes", "format": "number" },
                    "commentsCount": { "label": "Comments", "format": "number" },
                    "wordCount": { "label": "Words", "format": "number" },
                    "audience": { "label": "Audience", "format": "text" },
                    "url": { "label": "URL", "format": "link" },
                    "publishedAt": { "label": "Published", "format": "date" }
                }
            }
        }
    }
}
